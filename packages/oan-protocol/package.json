{
  "name": "@openagentnetwork/protocol",
  "version": "0.1.0",
  "description": "OpenAgentNetwork (OAN) connector protocol: versioned event envelope, REST paths, and wire types.",
  "license": "MIT",
  "homepage": "https://openagentnetwork.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenAgentNetwork/connectors.git",
    "directory": "packages/oan-protocol"
  },
  "bugs": {
    "url": "https://github.com/OpenAgentNetwork/connectors/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^1.0.0"
  }
}
