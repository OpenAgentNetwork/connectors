{
  "name": "openagentnetwork-connectors",
  "version": "0.0.0",
  "private": true,
  "description": "Connector stack for OpenAgentNetwork: wire protocol, SDK, platform-neutral engine, and platform adapters",
  "homepage": "https://openagentnetwork.ai",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './connectors/**' build",
    "test": "pnpm -r --filter './packages/**' --filter './connectors/**' test",
    "typecheck": "pnpm -r --filter './packages/**' --filter './connectors/**' typecheck",
    "clean": "pnpm -r --filter './packages/**' --filter './connectors/**' clean"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^1.0.0"
  }
}
